{
  "name": "@mowa-bot/element",
  "version": "0.3.0",
  "description": "The Mowa Bot procedural character as a framework-free Web Component, with a one-line CDN build",
  "license": "MIT",
  "author": "ShmilyXI",
  "homepage": "https://mowa-bot.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShmilyXI/mowa-bot.git",
    "directory": "packages/element"
  },
  "bugs": "https://github.com/ShmilyXI/mowa-bot/issues",
  "keywords": [
    "web-component",
    "custom-element",
    "character",
    "avatar",
    "procedural",
    "svg",
    "animation",
    "mascot"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/mowa-bot.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/mowa-bot.js",
  "jsdelivr": "./dist/mowa-bot.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdn": "./dist/mowa-bot.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mowa-bot/engine": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
